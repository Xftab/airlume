# Copy this file to .env and fill in your own keys.  .env is git-ignored.
# NEVER commit real keys.  NEVER paste keys into chat.

# --- LLM providers (Phase 3; leave empty during Phase 0-2) ---
GROQ_API_KEY=
GOOGLE_AI_API_KEY=

# --- Data providers ---
OPENAQ_API_KEY=
# WAQI token is DISPLAY-ONLY (ToS forbids storing/analysing). Never written to data/.
WAQI_TOKEN=

# --- Map tiles ---
# Optional. If empty, the app runs with map_provider=None (plain dark background).
CARTO_API_KEY=

# --- App settings ---
AIRLUME_ENV=development
AIRLUME_DB_PATH=data/airlume.duckdb
AIRLUME_USE_FAKE_DATA=1
